# Centralized configuration for the Weather/AQI Station

# --- Network & Time ---
SSID = "NAME_OF_WIFI"
PASSWORD = "WIFI_PASSWORD"
OFFSET_HOURS = 0  # UTC offset in hours

# --- API Keys & Endpoints ---
# WARNING: In a real production environment, consider using secure storage
# or environment variables if your platform supports it, rather than plain text.
AQICN_API_KEY = "https://aqicn.org/json-api/doc/"  # Note: Checked original, kept as is
AQICN_CITY_ID = "NUMBER"  # Using ID instead of city name for reliability

# Coordinates (Latitude, Longitude)
LAT = 0.00000
LON = 0.00000

# --- Timing ---
UPDATE_INTERVAL_SECONDS = 3600  # 1 hour
RETRY_DELAY_SECONDS = 30  # Wait time on failure
TIMEOUT_SECONDS = 30  # WiFi connection timeout
HTTP_TIMEOUT_SECONDS = 10  # Per-request timeout for API calls

# --- Display & Thresholds ---
# Thresholds for highlighting metrics in RED
# Key: API key name, Value: {'label': Display string, 'threshold': Trigger value}
WEATHER_THRESHOLDS = {
    "temp": {"label": "TEMP  : ", "threshold": 80, "unit": "F"},
    "feels_like": {"label": "FEELS : ", "threshold": 80, "unit": "F"},
    "humidity": {"label": "HUMID : ", "threshold": 70, "unit": "%"},
    "wind_speed": {"label": "WIND  : ", "threshold": 25, "unit": "mph"},
}

AQI_THRESHOLDS = {
    "co":   {"label": "CO     : ", "threshold": 35},
    "no2":  {"label": "NO2    : ", "threshold": 200},
    "o3":   {"label": "O3     : ", "threshold": 160},
    "pm10": {"label": "PM10   : ", "threshold": 80},
    "pm25": {"label": "PM2.5  : ", "threshold": 30},
    "so2":  {"label": "SO2    : ", "threshold": 270},
}

TOTAL_AQI_THRESHOLD = 100
